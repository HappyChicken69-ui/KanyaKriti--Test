# GROQ API Configuration (Server-Side Only - Never expose to client)
# Used for Whisper STT and LLaMA structured extraction
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3

# APP_URL: Injected automatically at runtime with Cloud Run URL
APP_URL=

# Authentication Secret
JWT_SECRET=

# MongoDB User & Identity Database (Server-Side Only)
MONGODB_URI=mongodb+srv://user_1:<db_password>@kanyakriti.oeomima.mongodb.net/?appName=kanyakriti
MONGODB_DB_NAME=kanyakriti_db
